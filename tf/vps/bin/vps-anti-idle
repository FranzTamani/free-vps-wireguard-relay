#!/usr/bin/env bash
# Keeps instance CPU and memory utilization at >=20-25% to prevent Oracle from
# reclaiming the Always Free instance on free tier / non-PAYG accounts.
# Automatically adapts to available memory and drops priority (nice 19) so real
# workloads are never impacted.
source "$(dirname "$(readlink -f "$0")")/vps-lib.sh"
require_root

ENABLED="$(cfg '.anti_idle.enabled // true')"
if [[ "$ENABLED" != true ]]; then
  log "anti-idle is disabled in config"
  exit 0
fi

CPU_TARGET="$(cfg '.anti_idle.cpu_target_pct // 25')"
MEM_TARGET="$(cfg '.anti_idle.memory_target_pct // 25')"

log "starting anti-idle keepalive (target CPU: ${CPU_TARGET}%, target MEM: ${MEM_TARGET}%)"

# Use python3 to smoothly throttle CPU in micro-intervals and hold memory
exec python3 -u - "$CPU_TARGET" "$MEM_TARGET" << 'EOF'
import sys
import os
import time
import threading
import signal

cpu_target_pct = float(sys.argv[1]) if len(sys.argv) > 1 else 25.0
mem_target_pct = float(sys.argv[2]) if len(sys.argv) > 2 else 25.0

# Clamp to sensible bounds
cpu_target_pct = max(0.0, min(90.0, cpu_target_pct))
mem_target_pct = max(0.0, min(80.0, mem_target_pct))

stop_event = threading.Event()

def signal_handler(signum, frame):
    stop_event.set()

signal.signal(signal.SIGTERM, signal_handler)
signal.signal(signal.SIGINT, signal_handler)

# --- Memory Hold Worker ---
# Keeps memory usage at or slightly above mem_target_pct so Oracle's 95th percentile
# check (>20% memory on A1 shapes) succeeds.
allocated_buffer = None

def get_meminfo():
    info = {}
    try:
        with open("/proc/meminfo", "r") as f:
            for line in f:
                parts = line.split(":")
                if len(parts) == 2:
                    key = parts[0].strip()
                    val = parts[1].strip().split()[0]
                    info[key] = int(val) * 1024  # bytes
    except Exception:
        pass
    return info

def adjust_memory():
    global allocated_buffer
    info = get_meminfo()
    if "MemTotal" not in info or "MemAvailable" not in info:
        return

    mem_total = info["MemTotal"]
    mem_avail = info["MemAvailable"]
    mem_used = mem_total - mem_avail

    target_bytes = int(mem_total * (mem_target_pct / 100.0))
    # Safety guard: never leave less than 400 MB available for system/SSH/wireguard
    safe_max_alloc = max(0, mem_avail - (400 * 1024 * 1024))

    needed_bytes = target_bytes - mem_used
    if allocated_buffer is not None:
        needed_bytes += len(allocated_buffer)

    needed_bytes = min(needed_bytes, safe_max_alloc)

    if needed_bytes > (10 * 1024 * 1024):  # Only allocate if >= 10 MB needed
        try:
            # Allocate and touch each 4KB page so memory is actually committed (RSS)
            new_buf = bytearray(needed_bytes)
            for i in range(0, needed_bytes, 4096):
                new_buf[i] = 1
            allocated_buffer = new_buf
        except MemoryError:
            allocated_buffer = None
    elif needed_bytes <= 0:
        allocated_buffer = None

# Initial memory allocation
adjust_memory()

# Memory supervisor thread: rechecks every 60 seconds
def mem_supervisor():
    while not stop_event.wait(60):
        adjust_memory()

mem_thread = threading.Thread(target=mem_supervisor, daemon=True)
mem_thread.start()

# --- CPU Load Worker ---
# Uses short 0.5-second cycles to maintain consistent ~25% CPU without spikes.
cycle_seconds = 0.5
busy_fraction = cpu_target_pct / 100.0
busy_seconds = cycle_seconds * busy_fraction
sleep_seconds = cycle_seconds - busy_seconds

def cpu_worker():
    while not stop_event.is_set():
        if busy_seconds > 0:
            end_time = time.perf_counter() + busy_seconds
            while time.perf_counter() < end_time and not stop_event.is_set():
                _ = 12345 * 54321
        if sleep_seconds > 0:
            time.sleep(sleep_seconds)

num_cores = os.cpu_count() or 1
threads = []
for _ in range(num_cores):
    t = threading.Thread(target=cpu_worker, daemon=True)
    t.start()
    threads.append(t)

# Wait until stopped
while not stop_event.is_set():
    stop_event.wait(1)

EOF
